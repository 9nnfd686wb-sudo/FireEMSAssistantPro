{
  "protocolId": "chestPain",
  "protocolName": "胸痛プロトコル",
  "questions": [
    {
      "id": "consciousnessImpairment",
      "type": "yesno",
      "label": "意識障害がありますか？",
      "required": true,
      "flags": [
        {
          "id": "consciousness_impairment",
          "label": "意識障害",
          "severity": "critical"
        }
      ]
    },
    {
      "id": "breathingStatus",
      "type": "yesno",
      "label": "呼吸はありますか？",
      "required": true,
      "flags": [
        {
          "id": "respiratory_arrest",
          "label": "呼吸停止",
          "severity": "critical",
          "triggerOnFalse": true
        }
      ]
    },
    {
      "id": "chestPainOnset",
      "type": "yesno",
      "label": "突然発症ですか？",
      "required": true,
      "flags": [
        {
          "id": "sudden_onset",
          "label": "突然発症",
          "severity": "high"
        }
      ]
    },
    {
      "id": "chestPainLocation",
      "type": "select",
      "label": "胸痛の部位はどこですか？",
      "options": ["左胸部", "右胸部", "中央胸部", "上胸部", "その他"],
      "required": true
    },
    {
      "id": "radiation",
      "type": "select",
      "label": "痛みはどこに放散していますか？",
      "options": ["なし", "左肩", "左腕", "背中", "顎"],
      "required": true,
      "flags": [
        {
          "id": "radiation_pain",
          "label": "放散痛",
          "severity": "high"
        }
      ]
    },
    {
      "id": "coldSweat",
      "type": "yesno",
      "label": "冷汗はありますか？",
      "required": false,
      "flags": [
        {
          "id": "cold_sweat",
          "label": "冷汗",
          "severity": "medium"
        }
      ]
    },
    {
      "id": "breathingDifficulty",
      "type": "yesno",
      "label": "呼吸困難がありますか？",
      "required": false,
      "flags": [
        {
          "id": "breathing_difficulty",
          "label": "呼吸困難",
          "severity": "critical"
        }
      ]
    },
    {
      "id": "chestPainSeverity",
      "type": "number",
      "label": "痛みの強さ（0〜10）を入力してください",
      "min": 0,
      "max": 10,
      "required": true
    },
    {
  "id": "medicalHistory",
  "type": "select",
  "label": "既往歴を選択してください",
  "required": false,
  "options": [
    "なし",
    "不明",
    "心疾患",
    "高血圧",
    "糖尿病",
    "脳卒中",
    "心房細動",
    "腎不全",
    "COPD",
    "喘息"
  ]
},
    {
  "id":"medications",
  "type":"select",
  "label":"内服薬を選択してください",
  "required":false,
  "options":[
      "なし",
      "不明",
      "抗凝固薬",
      "抗血小板薬",
      "ニトロ",
      "インスリン",
      "降圧薬"
  ]
}
  ]
}
